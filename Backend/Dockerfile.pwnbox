FROM ubuntu:20.04

# Avoid prompts
ENV DEBIAN_FRONTEND=noninteractive

# Install dependencies
RUN apt-get update && \
    echo "wireshark-common wireshark-common/install-setuid boolean true" | debconf-set-selections && \
    DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    openssh-server \
    sudo \
    iproute2 \
    net-tools \
    iputils-ping \
    dnsutils \
    whois \
    vim \
    nano \
    curl \
    wget \
    python3 \
    python3-pip \
    netcat \
    nmap \
    tcpdump \
    tshark \
    mtr-tiny \
    git \
    nodejs \
    npm \
    && rm -rf /var/lib/apt/lists/*

# Install Python packages for Phantom Shop and AI Simulator
RUN pip3 install flask flask-cors

# Install Node.js packages globally
RUN npm install -g express body-parser

# Setup SSH
RUN mkdir /var/run/sshd

# Create user 'chakra' with password 'user'
RUN useradd -m -s /bin/bash chakra && \
    echo 'chakra:user' | chpasswd && \
    usermod -aG sudo chakra && \
    echo "chakra ALL=(ALL) NOPASSWD:ALL" >> /etc/sudoers && \
    (groupadd wireshark || true) && \
    usermod -aG wireshark chakra

# Install additional toolsets for specialized red-teaming
RUN apt-get update && apt-get install -y \
    hashcat \
    john \
    hydra \
    gobuster \
    sqlmap \
    && rm -rf /var/lib/apt/lists/*

# Configure SSH to allow password auth
RUN sed -i 's/#PasswordAuthentication yes/PasswordAuthentication yes/' /etc/ssh/sshd_config
RUN sed -i 's/PasswordAuthentication no/PasswordAuthentication yes/' /etc/ssh/sshd_config

# Setup Level 1 Challenges
WORKDIR /home/chakra

# Level 1: Dashed filename
# "The password for the next level is in the file '-'"
RUN echo 'chakra{dashed_filename_master}' > -
RUN chown chakra:chakra -

# Readme and Custom MOTD
RUN echo "\n\
    ██████╗██╗  ██╗ █████╗ ██╗  ██╗██████╗  █████╗     ██╗   ██╗██╗███████╗██╗    ██╗\n\
    ██╔════╝██║  ██║██╔══██╗██║ ██╔╝██╔══██╗██╔══██╗    ██║   ██║██║██╔════╝██║    ██║\n\
    ██║     ███████║███████║█████╔╝ ██████╔╝███████║    ██║   ██║██║█████╗  ██║ █╗ ██║\n\
    ██║     ██╔══██║██╔══██║██╔═██╗ ██╔══██╗██╔══██║    ╚██╗ ██╔╝██║██╔══╝  ██║███╗██║\n\
    ╚██████╗██║  ██║██║  ██║██║  ██╗██║  ██║██║  ██║     ╚████╔╝ ██║███████╗╚███╔███╔╝\n\
    ╚═════╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝╚═╝  ╚═╝      ╚═══╝  ╚═╝╚══════╝ ╚══╝╚══╝ \n\n\
    OS: Chakra-Kernel (Ubuntu 20.04 LTS)\n\
    ACCESS: Sudo-Enabled (Unrestricted)\n\n\
    [!] This is a pure Linux environment. Windows commands (CMD/PowerShell) are not applicable.\n\
    [!] To install new tools: sudo apt update && sudo apt install <package>\n" > /etc/motd

RUN echo "Welcome to Chakra PwnBox!\n\nLevel 1 Goal: Read the file named '-'.\nUse 'cat -- -' to read files starting with a dash.\n" > /home/chakra/README.txt
RUN chown chakra:chakra /home/chakra/README.txt

# Add helpful aliases for Windows-minded users
RUN echo "alias ipconfig='echo [!] Use ip addr or ifconfig on Linux'" >> /home/chakra/.bashrc && \
    echo "alias cls='clear'" >> /home/chakra/.bashrc && \
    echo "alias help='echo [!] This is Linux. Use man <command> for help.'" >> /home/chakra/.bashrc && \
    echo "alias dir='ls -F'" >> /home/chakra/.bashrc

# Copy Phantom Shop, AI Simulator, and Easy Labs
COPY phantom-shop /opt/phantom-shop
COPY ai_simulator.py /opt/ai_simulator.py
COPY service-discovery-lab /opt/service-discovery-lab
COPY easy-labs /opt/easy-labs
RUN chmod +x /opt/phantom-shop/start-services.sh
RUN chmod +x /opt/service-discovery-lab/start.sh
RUN chmod +x /opt/easy-labs/start_labs.sh

# Copy and setup startup script
COPY pwnbox-start.sh /start.sh
RUN tr -d '\r' < /start.sh > /start.sh.tmp && mv /start.sh.tmp /start.sh && chmod +x /start.sh

# Fix line endings for other scripts as well
RUN find /opt -name "*.sh" -exec sh -c "tr -d '\r' < {} > {}.tmp && mv {}.tmp {} && chmod +x {}" \;

EXPOSE 22 8088 9091 5101 5102 5103 5104 5105

CMD ["/start.sh"]
