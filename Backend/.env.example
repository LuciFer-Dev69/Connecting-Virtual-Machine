# Database Configuration
DB_HOST=db
DB_USER=user
DB_PASSWORD=userpassword
DB_NAME=chakraDB
DB_PORT=3306

# Flask Configuration
FLASK_ENV=development
FLASK_APP=app.py
SECRET_KEY=your-secret-key-here

# SSH Configuration (for PwnBox)
SSH_HOST=pwnbox
SSH_PORT=22
SSH_USER=chakra
SSH_PASSWORD=user

# AI Challenge Config (Ollama Integration)
# For local development outside Docker: http://localhost:11434/api/generate
# For Docker deployment (Default): http://host.docker.internal:11434/api/generate
OLLAMA_URL=http://host.docker.internal:11434/api/generate
AI_MODEL=gemma3:4b

# Docker Configuration
DOCKER_HOST=unix:///var/run/docker.sock
